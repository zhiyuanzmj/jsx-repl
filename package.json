{
  "name": "jsx-repl",
  "version": "0.0.17",
  "description": "JSX REPL",
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "main": "dist/ssr-stub.js",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/ssr-stub.js"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/index.css",
    "./dist/style.css": "./dist/index.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "dev": "DEV=true vite",
    "dev:lib": "DEV=true vite build -c vite.lib.config.ts --watch",
    "play": "pnpm run -C ./playground dev",
    "server:dev": "nitro dev",
    "server:build": "prisma generate --no-engine && prisma migrate deploy && nitro build",
    "vercel:build": "pnpm server:build && pnpm build",
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsmc",
    "format": "prettier --write .",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsmc --noEmit",
    "release": "bumpp --all",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "prepublishOnly": "npm run build",
    "deploy": "pnpm run build && rsync -v -a --delete ./.vercel/output/static/ root@zmjs.dev:/usr/share/nginx/html/repl"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false"
  },
  "lint-staged": {
    "*": [
      "prettier --write --cache --ignore-unknown"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiyuanzmj/jsx-repl.git"
  },
  "author": "Evan You",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vuejs/repl/issues"
  },
  "homepage": "https://github.com/vuejs/repl#readme",
  "devDependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@babel/types": "^7.28.6",
    "@eslint/js": "^9.35.0",
    "@iconify-json/carbon": "^1.2.13",
    "@prisma/client": "^6.15.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@rollup/plugin-replace": "^6.0.2",
    "@shikijs/monaco": "^3.12.2",
    "@ts-macro/language-plugin": "^0.3.7",
    "@ts-macro/tsc": "^0.3.7",
    "@types/node": "^22.18.1",
    "@volar/jsdelivr": "~2.4.23",
    "@volar/monaco": "~2.4.23",
    "@volar/source-map": "^2.4.23",
    "@vue-jsx-vapor/eslint": "^2.6.4",
    "assert": "^2.1.0",
    "ast-kit": "^2.1.2",
    "bumpp": "^10.2.3",
    "conventional-changelog-cli": "^5.0.0",
    "diff-match-patch-es": "^1.0.1",
    "eslint": "^9.35.0",
    "fflate": "^0.8.2",
    "floating-vue": "^5.2.2",
    "jszip": "^3.10.1",
    "lint-staged": "^16.1.6",
    "magic-string": "^0.30.18",
    "monaco-editor-core": "^0.52.2",
    "nitropack": "^2.12.5",
    "ofetch": "^1.4.1",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "shiki": "^3.12.2",
    "simple-git-hooks": "^2.13.1",
    "source-map-js": "^1.2.1",
    "sucrase": "^3.35.0",
    "ts-macro": "^0.3.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-utils": "^0.3.1",
    "unplugin-vue-reactivity-function": "^1.2.0",
    "vite": "8.0.0-beta.13",
    "vite-plugin-inspect": "^11.3.3",
    "volar-plugin-ignore-attributes": "^0.2.6",
    "volar-service-typescript": "^0.0.64",
    "vscode-uri": "^3.1.0",
    "vue": "catalog:",
    "vue-jsx": "catalog:"
  },
  "prisma": {
    "schema": "./server/prisma/schema.prisma"
  }
}
